{
  "manifest_version": 3,
  "name": "Profile Lock",
  "version": "1.0.0",
  "description": "Chrome profilini şifreyle kilitler: boşta kalmada, tarayıcı açılışında ve OS ekran kilidinde otomatik kilitlenir; tüm sekme/pencerelerde tutarlı çalışır.",
  "permissions": ["storage", "idle"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kilitle (tıkla)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "MacCtrl+M"
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
